// Standards AI server. Free Cloudflare Workers plan; nothing here can create a bill.
{
  "name": "standards-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // The AI model (Cloudflare Workers AI). Free plan: 10,000 "neurons" a day, then it pauses
  // until 00:00 UTC. To trade answer quality for more questions per day, swap the model for
  // "@cf/meta/llama-3.1-8b-instruct-fp8-fast" (roughly 6x more questions a day).
  "ai": { "binding": "AI" },
  // MODEL writes the answers; ROUTER_MODEL (small and cheap) works out what a messy search meant.
  // Only pages on wrastem.com may use this server. To also allow a page on your own computer,
  // add:  "ALLOWED_ORIGINS": "http://localhost:8000"  (several addresses: separate with commas).
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ROUTER_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
  },

  // At most 6 questions a minute from one visitor, and 3 kit requests a minute.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "PURCHASE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],

  // Purchase requests are emailed (free) to a verified address in the Cloudflare account.
  // That address is a secret, not written here: npx wrangler secret put NOTIFY_TO
  "send_email": [{ "name": "EMAIL" }],
  // The teacher's thank-you email goes through Resend (free plan) and stays off until this
  // secret is set: npx wrangler secret put RESEND_API_KEY  (see README.md)

  // The address the website calls. Cloudflare creates this DNS record itself.
  "routes": [{ "pattern": "ai.wrastem.com", "custom_domain": true }],

  // Questions show up in the dashboard under Workers & Pages > standards-ai > Logs (kept 7 days).
  "observability": { "enabled": true }
}
